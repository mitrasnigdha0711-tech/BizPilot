generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREELANCE_VIDEO_EDITOR                @map("freelance_video_editor")
  SMALL_VIDEO_EDITING_BUSINESS_OWNER    @map("small_video_editing_business_owner")
}

enum BusinessType {
  FREELANCE      @map("freelance")
  SMALL_BUSINESS @map("small_business")
}

enum ClientStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum ProjectStatus {
  PLANNED     @map("planned")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")
}

enum InvoiceStatus {
  DRAFT          @map("draft")
  SENT           @map("sent")
  PARTIALLY_PAID @map("partially_paid")
  PAID           @map("paid")
  OVERDUE        @map("overdue")
}

enum PaymentStatus {
  EXPECTED @map("expected")
  RECEIVED @map("received")
}

enum ReminderTone {
  FRIENDLY @map("friendly")
  FIRM     @map("firm")
  FINAL    @map("final")
}

enum ReminderStatus {
  DRAFT    @map("draft")
  APPROVED @map("approved")
  SENT     @map("sent")
}

enum RecurringFrequency {
  WEEKLY    @map("weekly")
  MONTHLY   @map("monthly")
  QUARTERLY @map("quarterly")
  YEARLY    @map("yearly")
}

enum RecurringBillStatus {
  ACTIVE @map("active")
  PAUSED @map("paused")
  ENDED  @map("ended")
}

enum GoalStatus {
  ACTIVE   @map("active")
  ACHIEVED @map("achieved")
  MISSED   @map("missed")
}

enum TaskType {
  TASK      @map("task")
  FOLLOW_UP @map("follow_up")
}

enum TaskStatus {
  OPEN      @map("open")
  COMPLETED @map("completed")
}

enum Priority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
}

enum InsightType {
  BUSINESS_ADVICE @map("business_advice")
  GROWTH_INSIGHT  @map("growth_insight")
  ALERT           @map("alert")
  NEXT_ACTION     @map("next_action")
}

enum InsightStatus {
  OPEN      @map("open")
  DISMISSED @map("dismissed")
  DONE      @map("done")
}

enum InsightSource {
  AI     @map("ai")
  SYSTEM @map("system")
}

enum SimulationScenarioType {
  DELAYED_PAYMENT @map("delayed_payment")
  CUSTOM          @map("custom")
}

enum SimulationStatus {
  DRAFT     @map("draft")
  COMPLETED @map("completed")
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  name                   String
  role                   Role      @default(FREELANCE_VIDEO_EDITOR)
  businessId             String?   @map("business_id") @db.Uuid
  isActive               Boolean   @default(true) @map("is_active")
  failedLoginCount       Int       @default(0) @map("failed_login_count")
  lockedUntil            DateTime? @map("locked_until")
  lastLoginAt            DateTime? @map("last_login_at")
  sessionToken           String?   @unique @map("session_token")
  signedOutAt            DateTime? @map("signed_out_at")
  passwordChangedAt      DateTime? @map("password_changed_at")
  passwordResetToken     String?   @map("password_reset_token")
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  business          Business?           @relation("UserBusiness", fields: [businessId], references: [id])
  ownedBusinesses   Business[]          @relation("BusinessOwner")
  clients           Client[]
  projects          Project[]
  invoices          Invoice[]
  payments          Payment[]
  reminders         Reminder[]
  expenses          Expens[]
  recurringBills    RecurringBill[]
  goals             Goal[]
  tasks             Task[]              @relation("TaskOwner")
  assignedTasks     Task[]              @relation("TaskAssignee")
  insights          Insight[]
  cashflowForecasts CashflowForecast[]
  simulations       Simulation[]
  healthScores      HealthScore[]
  quotes            Quote[]

  tokenVersion Int @default(0)
  @@map("users")
}

model Business {
  id                   String       @id @default(uuid()) @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  name                 String
  businessType         BusinessType @default(FREELANCE) @map("business_type")
  services             Json
  monthlyProjectTarget Int          @map("monthly_project_target")
  workingHoursStart    String       @map("working_hours_start")
  workingHoursEnd      String       @map("working_hours_end")
  currency             String
  userId               String       @map("user_id") @db.Uuid

  owner             User                @relation("BusinessOwner", fields: [userId], references: [id])
  members           User[]              @relation("UserBusiness")
  clients           Client[]
  projects          Project[]
  invoices          Invoice[]
  expenses          Expens[]
  recurringBills    RecurringBill[]
  goals             Goal[]
  insights          Insight[]
  cashflowForecasts CashflowForecast[]
  simulations       Simulation[]
  healthScores      HealthScore[]
  quotes            Quote[]

  @@index([userId])
  @@map("businesses")
}

model Client {
  id         String       @id @default(uuid()) @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  name       String
  email      String?
  phone      String?
  address    String?      @db.Text
  status     ClientStatus @default(ACTIVE)
  businessId String       @map("business_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid

  business  Business   @relation(fields: [businessId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  projects  Project[]
  invoices  Invoice[]
  payments  Payment[]
  reminders Reminder[]
  tasks     Task[]

  @@index([businessId])
  @@index([userId])
  @@map("clients")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  name        String
  clientId    String        @map("client_id") @db.Uuid
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?     @map("start_date") @db.Date
  deadline    DateTime      @db.Date
  value       Decimal?      @db.Decimal(12, 2)
  completedAt DateTime?     @map("completed_at")
  businessId  String        @map("business_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid

  client   Client    @relation(fields: [clientId], references: [id])
  business Business  @relation(fields: [businessId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  invoices Invoice[]
  expenses Expens[]
  tasks    Task[]
  insights Insight[]

  @@index([businessId])
  @@index([userId])
  @@index([clientId])
  @@map("projects")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  invoiceNumber String        @unique @map("invoice_number")
  clientId      String        @map("client_id") @db.Uuid
  projectId     String?       @map("project_id") @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  amount        Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue    Decimal       @map("balance_due") @db.Decimal(12, 2)
  businessId    String        @map("business_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid

  client      Client            @relation(fields: [clientId], references: [id])
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  business    Business          @relation(fields: [businessId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  lineItems   InvoiceLineItem[]
  payments    Payment[]
  reminders   Reminder[]
  insights    Insight[]
  simulations Simulation[]

  @@index([businessId])
  @@index([userId])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  invoiceId    String        @map("invoice_id") @db.Uuid
  clientId     String        @map("client_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(EXPECTED)
  expectedDate DateTime?     @map("expected_date") @db.Date
  receivedAt   DateTime?     @map("received_at")
  userId       String        @map("user_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([userId])
  @@map("payments")
}

model Reminder {
  id           String         @id @default(uuid()) @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  invoiceId    String         @map("invoice_id") @db.Uuid
  clientId     String         @map("client_id") @db.Uuid
  subject      String
  body         String         @db.Text
  tone         ReminderTone   @default(FRIENDLY)
  status       ReminderStatus @default(DRAFT)
  isUserEdited Boolean        @default(false) @map("is_user_edited")
  editedAt     DateTime?      @map("edited_at")
  approvedAt   DateTime?      @map("approved_at")
  sentAt       DateTime?      @map("sent_at")
  userId       String         @map("user_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([userId])
  @@map("reminders")
}

model Expens {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  expenseDate DateTime @map("expense_date") @db.Date
  projectId   String?  @map("project_id") @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  business Business  @relation(fields: [businessId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@map("expenses")
}

model RecurringBill {
  id           String               @id @default(uuid()) @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  name         String
  amount       Decimal              @db.Decimal(12, 2)
  frequency    RecurringFrequency   @default(MONTHLY)
  startDate    DateTime             @map("start_date") @db.Date
  endDate      DateTime?            @map("end_date") @db.Date
  nextDueDate  DateTime             @map("next_due_date") @db.Date
  lastPaidAt   DateTime?            @map("last_paid_at")
  status       RecurringBillStatus  @default(ACTIVE)
  businessId   String               @map("business_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@map("recurring_bills")
}

model Goal {
  id                 String     @id @default(uuid()) @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  title              String
  periodStart        DateTime   @map("period_start") @db.Date
  periodEnd          DateTime   @map("period_end") @db.Date
  targetProjectCount Int        @map("target_project_count")
  completedCount     Int        @default(0) @map("completed_count")
  status             GoalStatus @default(ACTIVE)
  businessId         String     @map("business_id") @db.Uuid
  userId             String     @map("user_id") @db.Uuid

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  tasks    Task[]

  @@index([businessId])
  @@index([userId])
  @@map("goals")
}

model Task {
  id               String     @id @default(uuid()) @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  title            String
  type             TaskType   @default(TASK)
  status           TaskStatus @default(OPEN)
  priority         Priority   @default(MEDIUM)
  priorityNote     String?    @map("priority_note") @db.Text
  dueDate          DateTime?  @map("due_date") @db.Date
  plannedWeekStart DateTime?  @map("planned_week_start") @db.Date
  completedAt      DateTime?  @map("completed_at")
  projectId        String?    @map("project_id") @db.Uuid
  clientId         String?    @map("client_id") @db.Uuid
  goalId           String?    @map("goal_id") @db.Uuid
  quoteId          String?    @map("quote_id") @db.Uuid
  assigneeId       String?    @map("assignee_id") @db.Uuid
  userId           String     @map("user_id") @db.Uuid

  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  goal     Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  quote    Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  user     User     @relation("TaskOwner", fields: [userId], references: [id])

  @@index([userId])
  @@index([assigneeId])
  @@map("tasks")
}

model Insight {
  id                String         @id @default(uuid()) @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  type              InsightType    @default(NEXT_ACTION)
  title             String
  body              String         @db.Text
  recommendedAction String?        @map("recommended_action") @db.Text
  priority          Priority       @default(MEDIUM)
  status            InsightStatus  @default(OPEN)
  source            InsightSource  @default(AI)
  isAlert           Boolean        @default(false) @map("is_alert")
  isStale           Boolean        @default(false) @map("is_stale")
  dueDate           DateTime?      @map("due_date") @db.Date
  periodStart       DateTime?      @map("period_start") @db.Date
  periodEnd         DateTime?      @map("period_end") @db.Date
  generatedAt       DateTime       @map("generated_at")
  expiresAt         DateTime?      @map("expires_at")
  dismissedAt       DateTime?      @map("dismissed_at")
  invoiceId         String?        @map("invoice_id") @db.Uuid
  projectId         String?        @map("project_id") @db.Uuid
  businessId        String         @map("business_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid

  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  business Business  @relation(fields: [businessId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@map("insights")
}

model CashflowForecast {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  horizonDays      Int      @default(30) @map("horizon_days")
  projectedInflow  Decimal  @map("projected_inflow") @db.Decimal(12, 2)
  projectedOutflow Decimal  @map("projected_outflow") @db.Decimal(12, 2)
  netCashflow      Decimal  @map("net_cashflow") @db.Decimal(12, 2)
  baselineBalance  Decimal? @map("baseline_balance") @db.Decimal(12, 2)
  projectedBalance Decimal? @map("projected_balance") @db.Decimal(12, 2)
  shortfallAmount  Decimal  @default(0) @map("shortfall_amount") @db.Decimal(12, 2)
  generatedAt      DateTime @map("generated_at")
  businessId       String   @map("business_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@map("cashflow_forecasts")
}

model Simulation {
  id                   String                 @id @default(uuid()) @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  name                 String
  scenarioType         SimulationScenarioType @default(DELAYED_PAYMENT) @map("scenario_type")
  delayDays            Int?                   @map("delay_days")
  invoiceId            String?                @map("invoice_id") @db.Uuid
  projectedPaymentDate DateTime?              @map("projected_payment_date") @db.Date
  status               SimulationStatus       @default(DRAFT)
  businessId           String                 @map("business_id") @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  projectedBalance     Decimal?               @map("projected_balance") @db.Decimal(12, 2)
  shortfallAmount      Decimal?               @map("shortfall_amount") @db.Decimal(12, 2)

  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@map("simulations")
}

model HealthScore {
  id                      String   @id @default(uuid()) @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  overallScore            Int      @map("overall_score")
  projectConsistencyScore Int      @map("project_consistency_score")
  paymentCollectionScore  Int      @map("payment_collection_score")
  cashflowStabilityScore  Int      @map("cashflow_stability_score")
  workloadScore           Int      @map("workload_score")
  expenseManagementScore  Int      @map("expense_management_score")
  generatedAt             DateTime @map("generated_at")
  businessId              String   @map("business_id") @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  dragFactors             Json?    @map("drag_factors")

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@map("health_scores")
}

model Quote {
  id                 String    @id @default(uuid()) @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  text               String    @db.Text
  author             String?
  personalSuggestion String?   @map("personal_suggestion") @db.Text
  displayDate        DateTime  @map("display_date") @db.Date
  isFavourite        Boolean   @default(false) @map("is_favourite")
  businessId         String    @map("business_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  challengeText      String?   @map("challenge_text")
  challengeStatus    String?   @map("challenge_status")

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  tasks    Task[]

  @@index([businessId])
  @@index([userId])
  @@map("quotes")
}